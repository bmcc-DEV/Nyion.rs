#version 460

// Rotary Position Embedding (RoPE) — in-place on Q and K

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    int pos;
    int head_dim;
    int n_heads;
    int n_kv_heads;
} pc;

layout(set = 0, binding = 0) buffer QBuf { float q_buf[]; };
layout(set = 0, binding = 1) buffer KBuf { float k_buf[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint hdim = uint(pc.head_dim);
    uint hh = hdim / 2;

    uint total = uint(pc.n_heads + pc.n_kv_heads) * hh;
    if (gid >= total) return;

    float pos_f = float(pc.pos);
    bool is_q = gid < uint(pc.n_heads) * hh;

    uint head = is_q ? gid / hh : (gid - uint(pc.n_heads) * hh) / hh;
    uint hidx = is_q ? gid % hh : (gid - uint(pc.n_heads) * hh) % hh;

    uint off = head * hdim;
    float freq = pos_f / pow(10000.0, 2.0 * float(hidx) / float(hdim));
    float c = cos(freq);
    float s = sin(freq);

    uint i0 = off + hidx;
    uint i1 = off + hidx + hh;

    if (is_q) {
        float x0 = q_buf[i0];
        float x1 = q_buf[i1];
        q_buf[i0] = x0 * c - x1 * s;
        q_buf[i1] = x0 * s + x1 * c;
    } else {
        float x0 = k_buf[i0];
        float x1 = k_buf[i1];
        k_buf[i0] = x0 * c - x1 * s;
        k_buf[i1] = x0 * s + x1 * c;
    }
}
